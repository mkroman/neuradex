{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    ":disableRateLimiting"
  ],
  "constraints": {
    "mise": "2026.10.19"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker build tool tags and checksums in hack/docker-tools.txt (Docker build tools only)",
      "managerFilePatterns": [
        "/^hack\\/docker-tools\\.txt$/"
      ],
      "matchStrings": [
        "\\[(?<tool>[a-z0-9-]+)\\]\\nrepo=(?<depName>[^\\n]+)\\nversion=(?<currentValue>[^\\n]+)\\nsha256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the curl image used by the kind deployment smoke test",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/deployment-test\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*CURL_IMAGE: [^:\\s]+:(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the pinned kind node image and digest",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/deployment-test\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*kind create cluster[\\s\\S]*?--image kindest/node:(?<currentValue>v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group pinned CI tool updates managed by mise",
      "matchManagers": [
        "mise"
      ],
      "groupName": "pinned CI tools",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group Docker build tool updates in hack/docker-tools.txt",
      "matchDatasources": [
        "github-release-attachments"
      ],
      "groupName": "pinned CI tools",
      "minimumReleaseAge": "7 days"
    }
  ]
}
