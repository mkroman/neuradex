{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    ":disableRateLimiting"
  ],
  "constraints": {
    "mise": "2026.10.19"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the curl image used by the kind deployment smoke test",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/deployment-test\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*CURL_IMAGE: [^:\\s]+:(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the pinned kind node image and digest",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/deployment-test\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*kind create cluster[\\s\\S]*?--image kindest/node:(?<currentValue>v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group pinned CI tool updates managed by mise",
      "matchManagers": [
        "mise"
      ],
      "groupName": "pinned CI tools",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group the mise CLI version across workflows, the Dockerfile, and tool constraints",
      "matchPackageNames": [
        "jdx/mise",
        "ghcr.io/jdx/mise",
        "mise"
      ],
      "groupName": "mise CLI"
    },
    {
      "description": "Group Docker build tool updates in mise.docker.toml",
      "matchFileNames": [
        "mise.docker.toml"
      ],
      "groupName": "docker build tools",
      "minimumReleaseAge": "7 days"
    }
  ]
}
